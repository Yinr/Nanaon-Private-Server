# Copy to .env for a local build. Values are examples; do not add passwords.
NANAON_STOCK_APK=../../../../apk-mod/work/original.apk
NANAON_TARGET_PACKAGE=com.aniplex.nananiji.ps227
NANAON_APP_NAME=ナナオン 227
NANAON_ENDPOINT_API_HOST=nanaon.0000227.xyz
NANAON_ENDPOINT_ASSET_HOST=nanaon.0000227.xyz
# Only endpoint hosts are listed here. User CA is opt-in below.
NANAON_PRIVATE_DOMAINS=nanaon.0000227.xyz
NANAON_ALLOW_USER_CA=false
NANAON_USE_ORIGINAL_HOST_VERIFIER=false
NANAON_OUTPUT_APK=../../../../apk-mod/out/nanaon-2.4.0-com.aniplex.nananiji.ps227.endpoint-domain.signed.apk
NANAON_KEYSTORE=../../../../apk-mod/keys/test.keystore
NANAON_KS_ALIAS=test
# Optional toolchain paths. Leave empty to auto-resolve: SDK layout under
# NANAON_SDK_ROOT / ANDROID_HOME / ANDROID_SDK_ROOT (build-tools 37.0.0 or
# newest; platforms/android-34 or newest) and an `apktool` on PATH (standalone
# JAR, or the conventional wrapper with apktool.jar beside it).
NANAON_BUILD_TOOLS=
NANAON_APKTOOL_JAR=
NANAON_ANDROID_JAR=
NANAON_TMP_ROOT=../../../../_tmp
