# nginx reverse-proxy deployment (alternative to the bundled tls_gateway.py)
#
# The gateway only terminates TLS and forwards every Host to one app process,
# which nginx does natively and with better logging/performance. Run the app
# alone (`python run.py --no-gateway`) and point nginx at 127.0.0.1:8888.
#
# Certificate: use the same self-signed pair generated by
# generate_gateway_certificate.py (var/certs/). It must NOT be re-generated
# after clients have installed the CA - treat it as a permanent asset.

server {
    listen 443 ssl;
    http2 on;
    server_name 227.hand.co.jp prd-asset.227.hand.co.jp;

    ssl_certificate     var/certs/gateway_trust_cert.pem;
    ssl_certificate_key var/certs/game_key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Game resource requests can be large; OBB-sized uploads are not expected.
    client_max_body_size 200m;

    location / {
        proxy_pass http://127.0.0.1:8888;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
    }

    # Optional: serve the download page straight from disk instead of Flask.
    # location /downloads/ {
    #     alias /opt/nanaon/www/;
    #     autoindex on;
    # }
}

# Unknown Hosts (direct IP probes, AWS/gaudiy telemetry domains): reject.
server {
    listen 443 ssl default_server;
    ssl_certificate     var/certs/gateway_trust_cert.pem;
    ssl_certificate_key var/certs/game_key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    return 404;
}
