nanaon.0000227.xyz {
	tls /etc/caddy/certs/nanaon-origin.crt /etc/caddy/certs/nanaon-origin.key
	# Keep diagnostics off the public origin.
	@private path /admin*
	respond @private 404

	# Static client download page and release files.
	@install_files path /downloads/*.apk /downloads/*.xapk /downloads/*.obb /downloads/SHA256SUMS.txt
	handle @install_files {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@downloads_root path /downloads /downloads/
	redir @downloads_root / 302
	@site_assets path /bgm.js /bgm.css
	handle @site_assets {
		root * /srv/www
		header Cache-Control "no-cache"
		file_server
	}
	@site path /
	handle @site {
		root * /srv/www
		header Cache-Control "no-cache"
		file_server
	}

	# API responses are per-user and must never be cached at the edge.
	@api path /api* /Prod*
	handle @api {
		header Cache-Control "no-store"
		reverse_proxy nanaon-app:8888 {
			header_down -Cache-Control
		}
	}

	# Resource URLs are content-addressed/versioned and can be cached safely.
	# Only successful responses may carry the long immutable TTL. A 404 must stay
	# uncacheable: otherwise the edge pins a missing asset for a year, and after
	# the asset is added the client still lands on the stale 404 on a random PoP.
	# `status` is a response matcher, so it only works inside handle_response —
	# `header_down @matcher` silently treats the name as a header instead.
	@assets path /assets/* /android/* /Android/*
	handle @assets {
		reverse_proxy nanaon-app:8888 {
			header_down -Cache-Control
			@cached status 200 206
			handle_response @cached {
				header Cache-Control "public, max-age=31536000, immutable"
				copy_response
			}
			handle_response {
				header Cache-Control "no-store, max-age=0"
				copy_response
			}
		}
	}

	reverse_proxy nanaon-app:8888
}
